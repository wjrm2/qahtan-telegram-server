# Telegram bot
BOT_TOKEN=ضع_توكن_بوت_Telegram_هنا

# AI providers (DeepSeek is the default; Groq remains a safe fallback)
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=ضع_مفتاح_DeepSeek_هنا
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
GROQ_API_KEY=ضع_مفتاح_Groq_هنا
GROQ_MODEL=llama-3.3-70b-versatile

# Developer access
DEVELOPER_IDS=123456789,987654321
DEVELOPER_MODE_CODE=غيّر_هذا_الرمز_إلى_رمز_سري_جديد

# Separate ports
BOT_PORT=8080
NODE_SERVER_PORT=3000
NODE_SERVER_URL=http://127.0.0.1:3000

# Credentials used by Node server
TELEGRAM_BOT_TOKEN=ضع_توكن_البوت_هنا
TELEGRAM_CHAT_ID=رقم_المحادثة_هنا
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=كلمة_مرور_تطبيق_Gmail

# Optional hosting settings
APP_URL=https://your-domain.example
NODE_ENV=production
DISABLE_HMR=true

# Optional feature settings
FEATURE_DATA_DIR=data
FEATURE_DB_PATH=data/features.sqlite3
MAX_DOWNLOAD_MB=50

# لا تضع أي قيم حقيقية في هذا الملف عند مشاركته.
